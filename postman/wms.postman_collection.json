    {
      "name": "Search and paging",
      "description": "List endpoints return { content, page, size, totalPages, totalElements }.",
      "item": [
        {
          "name": "Products - filter by name (case-insensitive)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('every name contains mouse', () => {",
                  "  pm.expect(body.content.length).to.be.at.least(1);",
                  "  body.content.forEach(p => pm.expect(p.name.toLowerCase()).to.include('mouse'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?name=MOUSE"
          }
        },
        {
          "name": "Products - filter by categoryId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
