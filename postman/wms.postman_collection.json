              "mode": "raw",
              "raw": "{\n  \"productId\": \"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\",\n  \"quantity\": 5,\n  \"unitCost\": 90.00\n}"
            }
          }
        },
        {
          "name": "Get all purchase orders",
