{
  "info": {
    "name": "WMS - Product API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires the seed data in src/main/resources/data.sql (loaded automatically on app startup). Run Create first: it saves `productId` for the requests after it."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8081" },
    { "key": "categoryId", "value": "11111111-1111-1111-1111-111111111111" },
    { "key": "categoryId2", "value": "22222222-2222-2222-2222-222222222222" },
    { "key": "seededProductId", "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa" },
    { "key": "seededProductCode", "value": "SEED-001" },
    { "key": "productId", "value": "" },
    { "key": "warehouseId", "value": "c1c1c1c1-c1c1-c1c1-c1c1-c1c1c1c1c1c1" },
    { "key": "supplierId", "value": "d1d1d1d1-d1d1-d1d1-d1d1-d1d1d1d1d1d1" },
    { "key": "userId", "value": "e1e1e1e1-e1e1-e1e1-e1e1-e1e1e1e1e1e1" },
    { "key": "purchaseOrderId", "value": "" }
  ],
  "item": [
    {
      "name": "Get all products (seeded)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "pm.test('contains seeded products', () => {",
              "  const codes = pm.response.json().map(p => p.productCode);",
              "  pm.expect(codes).to.include.members(['SEED-001', 'SEED-002']);",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products" }
    },
    {
      "name": "Get seeded product by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is the seeded mouse', () => {",
              "  pm.expect(body.productCode).to.eql('SEED-001');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{seededProductId}}" }
    },
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has id and expected fields', () => {",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.name).to.eql('Test product');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "});",
              "pm.collectionVariables.set('productId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productCode\": \"P-{{$randomInt}}\",\n  \"name\": \"Test product\",\n  \"description\": \"Created from Postman\",\n  \"price\": 10.50,\n  \"categoryId\": \"{{categoryId}}\"\n}"
        }
      }
    },
    {
      "name": "Get created product",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/products/{{productId}}" }
    },
    {
      "name": "Update product (change category)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('fields updated, category changed', () => {",
              "  pm.expect(body.name).to.eql('Updated product');",
              "  pm.expect(body.price).to.eql(20);",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId2'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated product\",\n  \"description\": \"Updated from Postman\",\n  \"price\": 20.00,\n  \"categoryId\": \"{{categoryId2}}\"\n}"
        }
      }
    },
    {
      "name": "Update product (partial - keeps other fields)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('only description changed', () => {",
              "  pm.expect(body.description).to.eql('Partial update');",
              "  pm.expect(body.name).to.eql('Updated product');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId2'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": { "mode": "raw", "raw": "{\n  \"description\": \"Partial update\"\n}" }
      }
    },
    {
      "name": "Delete product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.test('status is 204', () => pm.response.to.have.status(204));"]
          }
        }
      ],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/products/{{productId}}" }
    },
    {
      "name": "Edge cases",
      "item": [
        {
          "name": "Create - duplicate productCode (seeded SEED-001)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"{{seededProductCode}}\",\n  \"name\": \"Duplicate\",\n  \"price\": 1,\n  \"categoryId\": \"{{categoryId}}\"\n}"
            }
          }
        },
        {
          "name": "Create - unknown categoryId",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"P-{{$randomInt}}\",\n  \"name\": \"Bad category\",\n  \"price\": 1,\n  \"categoryId\": \"does-not-exist\"\n}"
            }
          }
        },
        {
          "name": "Create - missing categoryId (issue 2, currently 500)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productCode\": \"P-{{$randomInt}}\",\n  \"name\": \"No category\",\n  \"price\": 1\n}"
            }
          }
        },
        {
          "name": "Update - unknown product id",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/does-not-exist",
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Ghost\"\n}" }
          }
        },
        {
          "name": "Update - unknown categoryId",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/{{seededProductId}}",
            "body": { "mode": "raw", "raw": "{\n  \"categoryId\": \"does-not-exist\"\n}" }
          }
        },
        {
          "name": "Update - productCode taken by another product (issue 3, currently 500)",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/products/bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb",
            "body": { "mode": "raw", "raw": "{\n  \"productCode\": \"{{seededProductCode}}\"\n}" }
          }
        }
      ]
    },
    {
      "name": "Purchase order flow",
      "description": "Run in order. Create saves `purchaseOrderId`. Receive should add stock to inventory and create IN stock movements.",
      "item": [
        {
          "name": "Create purchase order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is pending with 1 item', () => {",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "  pm.expect(body.items).to.have.length(1);",
                  "});",
                  "pm.collectionVariables.set('purchaseOrderId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/purchase-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [\n    { \"productId\": \"{{seededProductId}}\", \"quantity\": 100, \"unitCost\": 12.00 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Add item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has 2 items', () => pm.expect(pm.response.json().items).to.have.length(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"bbbbbbbb-bbbb-bbbb-bbbb-bbbbbbbbbbbb\",\n  \"quantity\": 5,\n  \"unitCost\": 90.00\n}"
            }
          }
        },
        {
          "name": "Get all purchase orders",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/purchase-orders" }
        },
        {
          "name": "Get purchase order by id",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}" }
        },
        {
          "name": "Receive purchase order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('is received', () => pm.expect(pm.response.json().status).to.eql('RECEIVED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/receive",
            "body": { "mode": "raw", "raw": "{\n  \"receivedBy\": \"{{userId}}\"\n}" }
          }
        },
        {
          "name": "Receive again (should fail once status check is implemented)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/receive",
            "body": { "mode": "raw", "raw": "{\n  \"receivedBy\": \"{{userId}}\"\n}" }
          }
        },
        {
          "name": "Get inventory by warehouse",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('seeded mouse has stock', () => {",
                  "  const row = pm.response.json().find(i => i.productId === pm.collectionVariables.get('seededProductId'));",
                  "  pm.expect(row.quantity).to.be.at.least(100);",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory?warehouseId={{warehouseId}}" }
        },
        {
          "name": "Get inventory by product",
          "request": { "method": "GET", "url": "{{baseUrl}}/api/inventory?productId={{seededProductId}}" }
        },
        {
          "name": "Get stock movements",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has IN movements', () => {",
                  "  pm.expect(pm.response.json().some(m => m.movementType === 'IN')).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "GET", "url": "{{baseUrl}}/api/stock-movements?warehouseId={{warehouseId}}" }
        }
      ]
    }
  ]
}
