                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/products?categoryId={{categoryId2}}"
          }
        },
        {
          "name": "Products - filter by price range",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('every price is between 100 and 200', () => {",
                  "  pm.expect(body.content.length).to.be.at.least(1);",
                  "  body.content.forEach(p => { pm.expect(p.price).to.be.at.least(100); pm.expect(p.price).to.be.at.most(200); });",
                  "});"
