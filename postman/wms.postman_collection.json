{
  "info": {
    "name": "WMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Requires the seed data in src/main/resources/data.sql (reloaded on every startup, ddl-auto: create). Run the whole collection in order from a fresh start: Create product saves `productId`, Create purchase order saves `purchaseOrderId`, and Soft delete - in use needs the stock added by the Purchase order flow."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081"
    },
    {
      "key": "categoryId",
      "value": "11111111-1111-1111-1111-111111111111"
    },
    {
      "key": "categoryId2",
      "value": "22222222-2222-2222-2222-222222222222"
    },
    {
      "key": "seededProductId",
      "value": "aaaaaaaa-aaaa-aaaa-aaaa-aaaaaaaaaaaa"
    },
    {
      "key": "seededProductCode",
      "value": "SEED-001"
    },
    {
      "key": "productId",
      "value": ""
    },
    {
      "key": "warehouseId",
      "value": "c1c1c1c1-c1c1-c1c1-c1c1-c1c1c1c1c1c1"
    },
    {
      "key": "supplierId",
      "value": "d1d1d1d1-d1d1-d1d1-d1d1-d1d1d1d1d1d1"
    },
    {
      "key": "userId",
      "value": "e1e1e1e1-e1e1-e1e1-e1e1-e1e1e1e1e1e1"
    },
    {
      "key": "purchaseOrderId",
      "value": ""
    },
    {
      "key": "warehouseId2",
      "value": "c2c2c2c2-c2c2-c2c2-c2c2-c2c2c2c2c2c2"
    },
    {
      "key": "supplierId2",
      "value": "d2d2d2d2-d2d2-d2d2-d2d2-d2d2d2d2d2d2"
    }
  ],
  "item": [
    {
      "name": "Get all products (seeded)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is a page', () => {",
              "  pm.expect(body.content).to.be.an('array');",
              "  pm.expect(body).to.have.property('totalElements');",
              "  pm.expect(body.page).to.eql(0);",
              "});",
              "pm.test('contains seeded products', () => {",
              "  const codes = body.content.map(p => p.productCode);",
              "  pm.expect(codes).to.include.members(['SEED-001', 'SEED-002']);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products"
      }
    },
    {
      "name": "Get seeded product by id",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('is the seeded mouse', () => {",
              "  pm.expect(body.productCode).to.eql('SEED-001');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{seededProductId}}"
      }
    },
    {
      "name": "Create product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('has id and expected fields', () => {",
              "  pm.expect(body.id).to.be.a('string');",
              "  pm.expect(body.name).to.eql('Test product');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId'));",
              "});",
              "pm.collectionVariables.set('productId', body.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productCode\": \"P-{{$randomInt}}\",\n  \"name\": \"Test product\",\n  \"description\": \"Created from Postman\",\n  \"price\": 10.50,\n  \"categoryId\": \"{{categoryId}}\"\n}"
        }
      }
    },
    {
      "name": "Get created product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/products/{{productId}}"
      }
    },
    {
      "name": "Update product (change category)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('fields updated, category changed', () => {",
              "  pm.expect(body.name).to.eql('Updated product');",
              "  pm.expect(body.price).to.eql(20);",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId2'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Updated product\",\n  \"description\": \"Updated from Postman\",\n  \"price\": 20.00,\n  \"categoryId\": \"{{categoryId2}}\"\n}"
        }
      }
    },
    {
      "name": "Update product (partial - keeps other fields)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('only description changed', () => {",
              "  pm.expect(body.description).to.eql('Partial update');",
              "  pm.expect(body.name).to.eql('Updated product');",
              "  pm.expect(body.categoryId).to.eql(pm.collectionVariables.get('categoryId2'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/products/{{productId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"description\": \"Partial update\"\n}"
        }
      }
    },
    {
      "name": "Delete product",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 204', () => pm.response.to.have.status(204));"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/products/{{productId}}"
