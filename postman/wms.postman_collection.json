    {
      "name": "Purchase order flow",
      "description": "Run in order. Create saves `purchaseOrderId`. Receive should add stock to inventory and create IN stock movements.",
      "item": [
        {
          "name": "Create purchase order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('is pending with 1 item', () => {",
                  "  pm.expect(body.status).to.eql('PENDING');",
                  "  pm.expect(body.items).to.have.length(1);",
                  "});",
                  "pm.collectionVariables.set('purchaseOrderId', body.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/purchase-orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"supplierId\": \"{{supplierId}}\",\n  \"warehouseId\": \"{{warehouseId}}\",\n  \"items\": [\n    { \"productId\": \"{{seededProductId}}\", \"quantity\": 100, \"unitCost\": 12.00 }\n  ]\n}"
            }
          }
        },
        {
          "name": "Add item",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('has 2 items', () => pm.expect(pm.response.json().items).to.have.length(2));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/purchase-orders/{{purchaseOrderId}}/items",
